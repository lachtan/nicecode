{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/check-uv.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/format-python.sh"
          },
          {
            "type": "command",
            "command": "pwsh -File ${CLAUDE_PLUGIN_ROOT}/hooks/format-powershell.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -File ${CLAUDE_PLUGIN_ROOT}/hooks/fix-markdown.ps1"
          },
          {
            "type": "command",
            "command": "pwsh -File ${CLAUDE_PLUGIN_ROOT}/hooks/mermaid-lint.ps1"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/check-bash.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -File ${CLAUDE_PLUGIN_ROOT}/hooks/remove-nul.ps1"
          }
        ]
      }
    ]
  }
}
