{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -File ${CLAUDE_PLUGIN_ROOT}/hooks/fix-markdown.ps1"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -File ${CLAUDE_PLUGIN_ROOT}/hooks/mermaid-lint.ps1"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -File ${CLAUDE_PLUGIN_ROOT}/hooks/remove-nul.ps1"
          }
        ]
      }
    ]
  }
}
